#!/bin/sh
# Kenstel KAP-110 board network configuration
#
# VERIFIED LIVE on the initramfs build: this topology reaches 192.168.1.1 from a
# PC plugged into lan0-lan3.
#
# Topology confirmed from the working initramfs console:
#   eth0   = CPU port, ipqess-edma c080000.ethernet (netifd enslaves it to br-lan)
#   lan0   = swport1  PHY [90000.mdio-1:00] QCA8072
#   lan1   = swport2  PHY [90000.mdio-1:01]
#   lan2   = swport3  PHY [90000.mdio-1:02]
#   lan3   = swport4  PHY [90000.mdio-1:03]
#   wan    = swport5  PHY [90000.mdio-1:04]   <- deliberately NOT bridged
#
# All four LAN ports plus the CPU port sit in one bridge. There is no WAN port
# and no NAT: this is an access point, not a router.
#
# SYNTAX: ucidef_set_interfaces_lan_wan takes exactly TWO arguments - the LAN
# device(s) as ONE space-separated string, then the WAN device. There is no
# "bridge lan" prefix. Upstream ipq40xx boards use e.g.:
#     ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
# Passing "bridge lan lan0 lan1 ..." silently sets network.lan.device to the
# literal string "bridge", which is not an interface, and drops the ports, so the
# AP comes up with no reachable LAN. The bridge is created automatically from
# the device list.
#
# The helper does NOT set an IP address:
#   ucidef_set_interface_lan -> ucidef_set_interface "lan" device "$1" protocol static
# That yields proto=static with no ipaddr and no netmask, so br-lan comes up with
# no address and 192.168.1.1 is unreachable. ipaddr/netmask MUST be added here.
# (Verified in package/base-files/files/lib/functions/uci-defaults.sh.)
#
# NAMING: the stock (QSDK) firmware used eth1 with tagged VLANs (br-lan eth1.10,
# br-apman eth1.20, br-brman eth1.60, br-localman eth1). That does NOT translate
# to upstream OpenWrt, where DSA names the CPU port eth0 and the switch ports
# lan0-lan3/wan. Reproducing the VLAN design needs explicit vlan/untagged/pvid
# nodes in the DTS; without them the tagged interfaces come up but nothing
# forwards. Plain untagged LAN is the verified configuration.
#
# The vendor VLAN split (cloud management / backhaul) is intentionally dropped:
# the device is being taken off Kenstel's cloud, so those networks no longer
# have a purpose.

. /lib/functions.sh

# The config is written EXPLICITLY rather than through
# ucidef_set_interfaces_lan_wan. That helper emits JSON on stdout, which
# config_generate collects and merges; on this board the merge did not land and
# netifd fell back to its DSA default, producing:
#     config device
#             option name 'br-lan'
#             option type 'bridge'
#             list ports 'eth0'        <- CPU port only, no LAN ports
# so br-lan came up with eth0 alone and the switch ports were never enslaved.
# Writing /etc/config/network directly is deterministic and matches the layout
# verified working on the device (brctl showing lan0-lan3 in br-lan).
#
# Ports (from `ip -o link show` on the device):
#   lan0@eth0 .. lan3@eth0  = switch ports 1-4
#   wan@eth0                = switch port 5, deliberately not bridged
# eth0 is the CPU port and is NOT listed: adding it alongside the DSA children
# is what the generated config did wrong.

LAN_IP="192.168.1.1"
LAN_NETMASK="255.255.255.0"

{
	echo "config interface 'loopback'"
	echo "	option device 'lo'"
	echo "	option proto 'static'"
	echo "	list ipaddr '127.0.0.1/8'"

	echo
	echo "config device"
	echo "	option name 'br-lan'"
	echo "	option type 'bridge'"
	# Written out literally rather than looped over a variable, so CI can
	# assert each port is present and a reviewer can read the whole config here.
	echo "	list ports 'lan0'"
	echo "	list ports 'lan1'"
	echo "	list ports 'lan2'"
	echo "	list ports 'lan3'"

	echo
	echo "config interface 'lan'"
	echo "	option device 'br-lan'"
	echo "	option proto 'static'"
	echo "	list ipaddr '$LAN_IP/$LAN_NETMASK'"
	echo "	option ip6assign '60'"

	echo
	echo "config interface 'wan'"
	echo "	option device 'wan'"
	echo "	option proto 'dhcp'"
} > /etc/config/network

exit 0
