// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Kenstel KAP-110 dual-band indoor access point
 *
 * SoC:  Qualcomm IPQ4018 (IPQ4019 hw1.0, quad Cortex-A7 @717MHz)
 * NAND: GD5F1GQ1UC 128MiB, SLC, page size 2048
 * NOR:  GD25Q16 2MiB on spi0.0
 *
 * The stock firmware reports "Machine model: Qualcomm Technologies, Inc.
 * IPQ40xx/AP-DK01.1-C2" and boots FIT config@ap.dk01.1-c2, so the board follows
 * the AP-DK01 reference design. This DTS is therefore derived from the shipping
 * GL.iNet GL-A1300 DTS, which uses the same SoC, the same reference design and
 * the same ART precal offsets.
 *
 * Partition layout is taken verbatim from the stock boot log:
 *   spi0.0 (NOR): SBL1 MIBIB QSEE CDT DDRPARAMS APPSBLENV APPSBL ART
 *   spi0.1 (NAND): rootfs, 0x0 - 0x4000000 (64MiB)
 *
 * ART nvmem layout is confirmed by TWO independent sources:
 *   1. stock /lib/read_caldata_to_fs.sh
 *        dd if=<0:ART> of=/tmp/wifi0.caldata bs=32 count=377 skip=128   (0x1000)
 *        dd if=<0:ART> of=/tmp/wifi1.caldata bs=32 count=377 skip=640   (0x5000)
 *      377 * 32 = 12064 bytes = 0x2F20, matching the boot log exactly.
 *   2. the GL-A1300 upstream DTS precal_art_1000 / precal_art_5000.
 */

#include "qcom-ipq4019.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/soc/qcom,tcsr.h>

/ {
	model = "Kenstel KAP-110";
	compatible = "kenstel,kap110", "qcom,ipq4019";

	aliases {
		ethernet0 = &gmac;
		led-boot = &led_run;
		led-failsafe = &led_run;
		led-running = &led_run;
		led-upgrade = &led_run;
		label-mac-device = &swport4;
	};

	chosen {
		bootargs-append = " ubi.mtd=ubi root=/dev/ubiblock0_1";
	};

	soc {
		tcsr@1949000 {
			compatible = "qcom,tcsr";
			reg = <0x1949000 0x100>;
			qcom,wifi_glb_cfg = <TCSR_WIFI_GLB_CFG>;
		};

		tcsr@194b000 {
			/* select hostmode */
			compatible = "qcom,tcsr";
			reg = <0x194b000 0x100>;
			qcom,usb-hsphy-mode-select = <TCSR_USB_HSPHY_HOST_MODE>;
			status = "okay";
		};

		ess_tcsr@1953000 {
			compatible = "qcom,tcsr";
			reg = <0x1953000 0x1000>;
			qcom,ess-interface-select = <TCSR_ESS_PSGMII>;
		};

		tcsr@1957000 {
			compatible = "qcom,tcsr";
			reg = <0x1957000 0x100>;
			qcom,wifi_noc_memtype_m0_m2 = <TCSR_WIFI_NOC_MEMTYPE_M0_M2>;
		};
	};
};

&prng {
	status = "okay";
};

&mdio {
	status = "okay";
};

&blsp_dma {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&blsp1_spi1 {
	pinctrl-0 = <&spi0_pins>;
	pinctrl-names = "default";
	cs-gpios = <&tlmm 54 GPIO_ACTIVE_LOW>, <&tlmm 5 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <24000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "SBL1";
				reg = <0x00000000 0x00040000>;
				read-only;
			};

			partition@40000 {
				label = "MIBIB";
				reg = <0x00040000 0x00020000>;
				read-only;
			};

			partition@60000 {
				label = "QSEE";
				reg = <0x00060000 0x00060000>;
				read-only;
			};

			partition@c0000 {
				label = "CDT";
				reg = <0x000c0000 0x00010000>;
				read-only;
			};

			partition@d0000 {
				label = "DDRPARAMS";
				reg = <0x000d0000 0x00010000>;
				read-only;
			};

			partition@e0000 {
				label = "APPSBLENV"; /* u-boot env */
				reg = <0x000e0000 0x00010000>;
			};

			partition@f0000 {
				label = "APPSBL"; /* u-boot */
				reg = <0x000f0000 0x00080000>;
				read-only;
			};

			partition@170000 {
				label = "ART";
				reg = <0x00170000 0x00010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_gmac0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					macaddr_gmac1: macaddr@6 {
						reg = <0x6 0x6>;
						#nvmem-cell-cells = <1>;
					};

					/* wifi0 pre-calibration: 0x1000, 0x2F20 bytes */
					precal_art_1000: precal@1000 {
						reg = <0x1000 0x2f20>;
					};

					/* wifi1 pre-calibration: 0x5000, 0x2F20 bytes */
					precal_art_5000: precal@5000 {
						reg = <0x5000 0x2f20>;
					};
				};
			};
		}
	};

	spi-nand@1 {
		compatible = "spi-nand";
		reg = <1>;
		spi-max-frequency = <24000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "rootfs";
				reg = <0x00000000 0x04000000>;   /* 64 MiB */
			};
		};
	};
};

&blsp1_uart1 {
	pinctrl-0 = <&serial_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&tlmm {
	serial_pins: serial_pinmux {
		mux {
			pins = "gpio60", "gpio61";
			function = "blsp_uart0";
			bias-disable;
		};
	};

	i2c_0_pins: i2c_0_pinmux {
		pinmux {
			pins = "gpio58", "gpio59";
			function = "blsp_i2c0";
			bias-disable;
		};
	};

	spi0_pins: spi0_pinmux {
		mux_spi {
			function = "blsp_spi0";
			pins = "gpio55", "gpio56", "gpio57";
			drive-strength = <12>;
			bias-disable;
		};

		mux_cs {
			function = "gpio";
			pins = "gpio54", "gpio5";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	}
};

&blsp1_i2c3 {
	status = "okay";
};

&usb2 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb2_hs_phy {
	status = "okay";
};

&usb3_ss_phy {
	status = "okay";
};

&gmac {
	status = "okay";
};

&switch {
	status = "okay";
};

/*
 * Port map recovered from the stock boot log:
 *   eth1.10 -> br-lan       VLAN 10  client LAN
 *   eth1.20 -> br-apman     VLAN 20  cloud-managed AP
 *   eth1.60 -> br-brman     VLAN 60  backhaul / mesh
 *   eth1     -> br-localman  untagged native management (192.168.1.1)
 *
 * The AP-DK01 reference design has one gmac (eth1) carrying all VLANs, so a
 * single switch port carries the tagged VLANs and the CPU port handles the
 * untagged management network.
 */
&swport1 {
	status = "okay";
	label = "lan0";
};

&swport2 {
	status = "okay";
	label = "lan1";
};

&swport3 {
	status = "okay";
	label = "lan2";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_gmac0 2>;
};

&swport4 {
	status = "okay";
	label = "lan3";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_gmac0 0>;
};

&swport5 {
	status = "okay";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_gmac1>;
};

/*
 * wifi0 = 2.4 GHz, wifi1 = 5 GHz (from the stock boot log:
 * wifi0 FW wireless modes 0x680c, wifi1 FW wireless modes 0x1f9001).
 * pre-calibration is read straight out of the ART nvmem cells above, which
 * matches the offsets the stock firmware uses to extract the blobs.
 */
&wifi0 {
	status = "okay";
	nvmem-cell-names = "pre-calibration";
	nvmem-cells = <&precal_art_1000>;
};

&wifi1 {
	status = "okay";
	nvmem-cell-names = "pre-calibration";
	nvmem-cells = <&precal_art_5000>;
};